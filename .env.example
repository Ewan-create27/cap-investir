# Local : http://localhost:3000. En production : l'origine HTTPS exacte, sans slash final.
# APP_ORIGIN=http://localhost:3000
PORT=3000
DATABASE_PATH=./data/cap.sqlite

# Pour Docker Compose : domaine dont le DNS pointe vers le serveur.
CAP_DOMAIN=cap.example.com

# Connexion Neon, uniquement dans .env local ou les secrets Render, jamais sur GitHub.
# Vide : SQLite local ; obligatoire sur Render.
DATABASE_URL=
